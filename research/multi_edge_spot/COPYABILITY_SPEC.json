      "definition": "Fraction of leader net edge retained at follower 60-second prices; next-block/15s/5m/15m are sensitivities"
    },
    {
      "id": "liquidity_and_impact",
      "weight": 20,
      "definition": "Follower $20 exact-input quote impact and route depth at signal time"
    },
    {
      "id": "holding_time_fit",
      "weight": 15,
      "definition": "Enough time after public observation; penalize atomic/sub-minute edges"
    },
    {
      "id": "all_in_cost_burden",
      "weight": 15,
      "definition": "Pool fee + gas/L1/L2 or priority fee + slippage/impact + failure allowance relative to gross move"
    },
    {
      "id": "token_quality",
      "weight": 10,
      "definition": "Point-in-time token age, verified contract/mint, concentration and manipulation screens"
    },
    {
      "id": "trade_frequency_capacity",
      "weight": 5,
      "definition": "Frequency compatible with $100 reserve and no overlapping exposure"
    },
    {
      "id": "cluster_independence",
      "weight": 5,
      "definition": "Funding/entity/transfer/deployer/synchrony evidence that votes are independent"
    }
