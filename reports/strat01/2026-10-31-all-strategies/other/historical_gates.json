  "native_hypotheses": [
    {
      "id": "H1_SMART_WALLET_CONSENSUS_COPY",
      "mechanism": "Copy public spot demand from independently selected wallets only if edge survives follower delay and costs.",
      "network": "Base",
      "universe": "Point-in-time tokens at least180days old with a qualified USDC route,30complete days, median daily DEX volume >=1,000,000USD and $20 quote impact <=10bps. Thresholds are eligibility, not optimized alpha features.",
      "wallet_selection": "Monthly trailing90day WALLET_SCORING_SPEC gates; ProfitScore>=70 and CopyabilityScore>=70; related wallets clustered to one vote.",
      "entry": "Three independent eligible wallets buy the same token within6hours; copy at first qualified quote60seconds after third vote.",
      "delay_sensitivities": [
        "NEXT_BLOCK",
        15,
        300,
        900
      ],
      "sizing": "Lower of20% equity,25quote units and size whose planned stop loss plus all-in cost is <=0.5% equity.",
      "exit": "Earliest of two contributing clusters net-selling in6hours, three-ATR trailing on completed1h bars, or14day time stop.",
      "risk": "Independent risk engine may exit/veto; wallet signal cannot widen stop or increase size.",
      "comparators": [
        "cash",
        "risk-matched hold",
        "single-wallet copy reported but not selected",
        "existing ATR-volatility where applicable"
      ],
      "minimum_historical_sample": {
        "closed_follower_cycles": 100,
        "calendar_months": 6,
        "distinct_wallet_clusters": 20
      },
      "minimum_prospective_sample": {
        "calendar_days": 90,
        "closed_cycles": 30
      },
      "specific_acceptance": [
        "Primary60-second delay passes general acceptance",
        "At least50% of gross positive PnL remains after removing top3 winners",
        "No token contributes more than50% of net PnL",
        "Next-block result alone cannot qualify candidate"
      ],
      "reject_if": [
        "Historical wallet labels are backfilled",
        "Cost basis coverage below95%",
        "No follower-time exact quote",
        "Primary60-second stress result nonpositive",
        "Consensus votes are related clusters"
      ]
    },
    {
      "id": "H2_SMART_FLOW_ATR_CONFIRMATION",
